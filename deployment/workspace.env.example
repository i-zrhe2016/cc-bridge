# Copy to /etc/cc-bridge/workspace.env; replace placeholders. Never commit real credentials.
CCR_MANAGEMENT_URL=http://127.0.0.1:3458
CCR_GATEWAY_URL=http://127.0.0.1:3456
CCR_WEB_AUTH_TOKEN=replace-with-random-token-shared-with-ccr-env
# Optional: enables /admin; must differ from CCR_WEB_AUTH_TOKEN and CLERK_SECRET_KEY and contain at least 32 characters.
CC_BRIDGE_OPERATIONS_TOKEN=replace-with-another-independent-random-token-at-least-32-characters
CC_BRIDGE_PUBLIC_URL=http://localhost:3000
# Google login and persistent accounts: merge deployment/auth.env.example

# Exact origins trusted by the operator; missing/empty rejects all user connection saves.
CC_BRIDGE_UPSTREAM_ORIGINS=https://api.openai.com
